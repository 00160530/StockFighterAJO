{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockfighterajo-leaderboard-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockfighterajo-leaderboard-db",
      "database_id": "f0a34050-9b14-4163-8b87-952091c867a2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://00160530.github.io,http://127.0.0.1:4173,http://localhost:4173"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*.css",
        "**/*.txt"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "account_id": "24d8b4aa39f0912770915b6f8a41ec1f"
}
