# Public build values only. Copy to .env, fill your API, then use:
# node --env-file=.env tools/build-pages.mjs
# Leave API blank for single-player only. Never put Worker/admin secrets here.
TAIGU_API_BASE=
TAIGU_REQUIRE_ONLINE=false
# Optional; GitHub Actions detects its own repository automatically.
TAIGU_REPOSITORY_URL=
